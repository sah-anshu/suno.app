    <string name="family_clean_audio">आपकी आवाज़ बिना बदलाव के जाती है। सुनने से पहले उनका फ़ोन उनकी अपनी प्रोफ़ाइल लगाता है।</string>
    <string name="family_leave">छोड़ें</string>

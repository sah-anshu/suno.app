<resources>
    <string name="app_name">सुनो साथी</string>
    <string name="family_subtitle">जिनकी आप देखभाल करते हैं, उनसे पहुँच में कहीं से भी बात करें।</string>
    <string name="family_join_title">उनके सुनो से जुड़ें</string>
    <string name="family_join_body">उनके मददगार से मददगार मोड → सेटिंग → जुड़ने का कोड दिखाएँ खोलने को कहें, फिर स्कैन करें। उनका फ़ोन आपको अनुमति देने के लिए पूछेगा।</string>
    <string name="family_my_name">आपका नाम (उन्हें दिखेगा)</string>
